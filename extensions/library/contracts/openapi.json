    "/v1/items/{id}/resume": {
      "post": {
        "responses": {
          "200": {
            "$ref": "#/components/responses/Item"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeItem"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "description": "Queued items may provide source supplements. Confirmed URL items may backfill verified public metadata only and remain confirmed."
      }
    },
    "/v1/items/{id}/reanalyze": {
      "post": {
        "responses": {
          "200": {
            "$ref": "#/components/responses/Item"
          },
          "400": {
