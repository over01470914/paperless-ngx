{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperless.local/library/maintenance/backup-receipt.schema.json",
  "title": "Paperless Library maintenance receipt revision 1",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/drill"}
  ],
  "$defs": {
    "hash": {
      "type": "object",
      "required": ["size", "sha256"],
      "properties": {
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["count", "size"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "id", "created_at", "completed_at", "native_version", "native_image", "method", "counts", "files", "limitations", "offsite_verified"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"enum": ["snapshot", "restore_drill"]},
        "status": {"enum": ["in_progress", "success", "failed"]},
        "id": {"type": "string", "pattern": "^(snapshot-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}|drill-[0-9a-f]{32})$"},
        "created_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "native_version": {"const": "3.2.1"},
        "native_image": {"const": "ghcr.io/paperless-ngx/paperless-ngx:3.2.1"},
        "method": {"enum": ["native_directory_export_and_sqlite_online_backup", "isolated_native_directory_import_sqlite"]},
        "counts": {"type": ["object", "null"]},
        "files": {"type": ["object", "null"]},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "offsite_verified": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "in_progress"}}},
          "then": {"properties": {"completed_at": {"type": "null"}}},
          "else": {"properties": {"completed_at": {"type": "string"}}}
        }
      ]
    },
    "snapshot": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["native_container_id"],
          "properties": {
            "kind": {"const": "snapshot"},
            "id": {"pattern": "^snapshot-"},
            "method": {"const": "native_directory_export_and_sqlite_online_backup"},
            "native_container_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "counts": {
              "type": ["object", "null"],
              "required": ["documents", "records", "bundles", "originals", "thumbnails", "archives", "export_files", "export_bytes", "batches", "items", "spool_references", "spool_files", "file_references", "file_files"],
              "properties": {
                "documents": {"type": "integer", "minimum": 0},
                "records": {"type": "integer", "minimum": 0},
                "bundles": {"type": "integer", "minimum": 0},
                "originals": {"type": "integer", "minimum": 0},
                "thumbnails": {"type": "integer", "minimum": 0},
                "archives": {"type": "integer", "minimum": 0},
                "export_files": {"type": "integer", "minimum": 2},
                "export_bytes": {"type": "integer", "minimum": 0},
                "batches": {"type": "integer", "minimum": 0},
                "items": {"type": "integer", "minimum": 0},
                "spool_references": {"type": "integer", "minimum": 0},
                "spool_files": {"type": "integer", "minimum": 0},
                "file_references": {"type": "integer", "minimum": 0},
                "file_files": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "files": {
              "type": ["object", "null"],
              "required": ["inventory", "export", "private"],
              "properties": {
                "inventory": {"$ref": "#/$defs/hash"},
                "export": {"$ref": "#/$defs/totals"},
                "private": {"$ref": "#/$defs/totals"}
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {"properties": {"counts": {"type": "object"}, "files": {"type": "object"}, "completed_at": {"type": "string"}}},
      "else": {"properties": {"counts": {"type": "null"}, "files": {"type": "null"}}},
      "unevaluatedProperties": false
    },
    "drill": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["source_snapshot", "cleanup"],
          "properties": {
            "kind": {"const": "restore_drill"},
            "id": {"pattern": "^drill-"},
            "method": {"const": "isolated_native_directory_import_sqlite"},
            "source_snapshot": {"type": "string", "pattern": "^snapshot-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
            "cleanup": {"enum": ["pending", "complete", "retained"]},
            "counts": {
              "type": ["object", "null"],
              "required": ["documents", "batches", "items", "spool_references", "spool_files", "file_references", "file_files"],
              "properties": {
                "documents": {"type": "integer", "minimum": 0},
                "batches": {"type": "integer", "minimum": 0},
                "items": {"type": "integer", "minimum": 0},
                "spool_references": {"type": "integer", "minimum": 0},
                "spool_files": {"type": "integer", "minimum": 0},
                "file_references": {"type": "integer", "minimum": 0},
                "file_files": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "files": {
              "type": ["object", "null"],
              "required": ["source_receipt"],
              "properties": {"source_receipt": {"$ref": "#/$defs/hash"}},
              "additionalProperties": false
            }
          }
        }
      ],
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {"properties": {"counts": {"type": "object"}, "files": {"type": "object"}, "completed_at": {"type": "string"}}},
      "else": {"properties": {"counts": {"type": "null"}, "files": {"type": "null"}}},
      "unevaluatedProperties": false
    }
  }
}
